<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_simple_accounting" model="ir.module.category">
        <field name="name">Simple Accounting</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_simple_accounting" model="res.groups.privilege">
        <field name="name">Simple Accounting</field>
        <field name="category_id" ref="module_category_simple_accounting"/>
    </record>

    <record id="group_simple_accounting_user" model="res.groups">
        <field name="name">User: Record entries, invoices and payments</field>
        <field name="privilege_id" ref="res_groups_privilege_simple_accounting"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_simple_accounting_manager" model="res.groups">
        <field name="name">Manager: Configure accounts and taxes</field>
        <field name="privilege_id" ref="res_groups_privilege_simple_accounting"/>
        <field name="implied_ids" eval="[(4, ref('group_simple_accounting_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="ir_rule_simple_account_company" model="ir.rule">
            <field name="name">Simple Account: Multi Company</field>
            <field name="model_id" ref="model_simple_account"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="ir_rule_simple_tax_company" model="ir.rule">
            <field name="name">Simple Tax: Multi Company</field>
            <field name="model_id" ref="model_simple_tax"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="ir_rule_simple_transaction_company" model="ir.rule">
            <field name="name">Simple Transaction: Multi Company</field>
            <field name="model_id" ref="model_simple_transaction"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="ir_rule_simple_invoice_company" model="ir.rule">
            <field name="name">Simple Invoice: Multi Company</field>
            <field name="model_id" ref="model_simple_invoice"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record id="ir_rule_simple_payment_company" model="ir.rule">
            <field name="name">Simple Payment: Multi Company</field>
            <field name="model_id" ref="model_simple_payment"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>

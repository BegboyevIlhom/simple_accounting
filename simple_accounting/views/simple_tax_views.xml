<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="simple_tax_view_list" model="ir.ui.view">
        <field name="name">simple.tax.list</field>
        <field name="model">simple.tax</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="amount"/>
                <field name="type_tax_use"/>
            </list>
        </field>
    </record>

    <record id="simple_tax_view_form" model="ir.ui.view">
        <field name="name">simple.tax.form</field>
        <field name="model">simple.tax</field>
        <field name="arch" type="xml">
            <form string="Tax">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="amount"/>
                        <field name="type_tax_use"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="simple_tax_action" model="ir.actions.act_window">
        <field name="name">Taxes</field>
        <field name="res_model">simple.tax</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a tax rate, e.g. "VAT 12%".
            </p>
        </field>
    </record>
</odoo>

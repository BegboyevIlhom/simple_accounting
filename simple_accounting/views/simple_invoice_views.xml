<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="simple_invoice_view_list" model="ir.ui.view">
        <field name="name">simple.invoice.list</field>
        <field name="model">simple.invoice</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="due_date"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_residual" sum="Outstanding"/>
                <field name="payment_state" widget="badge"
                    decoration-success="payment_state == 'paid'"
                    decoration-warning="payment_state == 'partial'"
                    decoration-danger="payment_state == 'not_paid'"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <record id="simple_invoice_view_form" model="ir.ui.view">
        <field name="name">simple.invoice.form</field>
        <field name="model">simple.invoice</field>
        <field name="arch" type="xml">
            <form string="Invoice">
                <header>
                    <button name="action_post" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'posted'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(simple_accounting.simple_payment_action)d" type="action"
                            class="oe_stat_button" icon="fa-money"
                            context="{'default_invoice_id': id}"
                            invisible="state != 'posted' or payment_state == 'paid'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Register</span>
                                <span class="o_stat_text">Payment</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="move_type"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="due_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_id"/>
                                    <field name="price_subtotal" sum="Subtotal"/>
                                    <field name="price_tax" sum="Tax"/>
                                    <field name="price_total" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                <field name="amount_paid"/>
                                <field name="amount_residual"/>
                            </group>
                        </page>
                        <page string="Payments" name="payments">
                            <field name="payment_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="cash_account_id"/>
                                    <field name="category_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="memo"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="simple_invoice_view_search" model="ir.ui.view">
        <field name="name">simple.invoice.search</field>
        <field name="model">simple.invoice</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter name="not_paid" string="Not Paid" domain="[('payment_state', '=', 'not_paid')]"/>
                <filter name="paid" string="Paid" domain="[('payment_state', '=', 'paid')]"/>
                <group>
                    <filter name="group_partner" string="Contact" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="simple_invoice_customer_action" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">simple.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_posted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first customer invoice.
            </p>
        </field>
    </record>

    <record id="simple_invoice_vendor_action" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">simple.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'search_default_posted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first vendor bill.
            </p>
        </field>
    </record>
</odoo>

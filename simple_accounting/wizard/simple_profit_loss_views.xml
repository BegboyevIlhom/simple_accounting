<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="simple_profit_loss_wizard_view_form" model="ir.ui.view">
        <field name="name">simple.profit.loss.wizard.form</field>
        <field name="model">simple.profit.loss.wizard</field>
        <field name="arch" type="xml">
            <form string="Profit &amp; Loss">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <button name="action_generate" string="Generate" type="object" class="oe_highlight"/>
                <field name="line_ids" invisible="not line_ids">
                    <list>
                        <field name="category_id"/>
                        <field name="account_type"/>
                        <field name="amount"/>
                    </list>
                </field>
                <group class="oe_subtotal_footer" invisible="not line_ids">
                    <field name="total_income"/>
                    <field name="total_expense"/>
                    <field name="net_profit" class="oe_subtotal_footer_separator"/>
                </group>
            </form>
        </field>
    </record>

    <record id="simple_profit_loss_wizard_action" model="ir.actions.act_window">
        <field name="name">Profit &amp; Loss</field>
        <field name="res_model">simple.profit.loss.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
